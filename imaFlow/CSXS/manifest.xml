<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="8.0" ExtensionBundleId="com.anhyeu.imaflow"
    ExtensionBundleVersion="1.0.0" ExtensionBundleName="imaFlow">

    <ExtensionList>
        <Extension Id="com.anhyeu.imaflow.panel" Version="1.0.0" />
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <!-- PHXS = Photoshop. Version 19.0 = Photoshop CC 2018 -->
            <Host Name="PHXS" Version="[19.0,99.0]" />
            <Host Name="PHSP" Version="[19.0,99.0]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="8.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.anhyeu.imaflow.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>imaFlow</Menu>
                    <Geometry>
                        <Size>
                            <Height>90</Height>
                            <Width>200</Width>
                        </Size>
                        <MinSize>
                            <Height>45</Height>
                            <Width>130</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>800</Height>
                            <Width>800</Width>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/icon_normal.png</Icon>
                        <Icon Type="Normal@2x">./icons/icon_normal@2x.png</Icon>
                        <Icon Type="RollOver">./icons/icon_rollover.png</Icon>
                        <Icon Type="RollOver@2x">./icons/icon_rollover@2x.png</Icon>
                        <Icon Type="Disabled">./icons/icon_disabled.png</Icon>
                        <Icon Type="DarkNormal">./icons/icon_dark_normal.png</Icon>
                        <Icon Type="DarkNormal@2x">./icons/icon_dark_normal@2x.png</Icon>
                        <Icon Type="DarkRollOver">./icons/icon_dark_rollover.png</Icon>
                        <Icon Type="DarkRollOver@2x">./icons/icon_dark_rollover@2x.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>

</ExtensionManifest>
